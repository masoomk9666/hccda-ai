   "source": [
    "# Q15. Creating Categories with pd.cut()\n",
    "# Create a new column named age_group using the following age intervals:\n",
    "\n",
    "# 15–18: 15-18\n",
    "\n",
    "# Above 18 to 21: 19-21\n",
    "\n",
    "# Above 21 to 24: 22-24\n",
    "\n",
    "# Above 24 to 35: 25+\n",
    "\n",
    "# Use pd.cut() to assign the appropriate category to each student.\n",
    "\n",
    "df['age_group'] = pd.cut(\n",
    "    df['age'],\n",
    "    bins=[15, 18, 21, 24, 35],\n",
    "    labels=['15-18', '19-21', '22-24', '25+'],\n",
    "    include_lowest=True,\n",
    "    right=True\n",
    ")\n",
    "\n",
    "df[['age', 'age_group']]"
   ]
  },
