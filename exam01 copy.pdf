   "source": [
    "# Q13. Creating a New Column\n",
    "# Create a new column named total_screen_time by adding social_media_hours and netflix_hours.\n",
    "\n",
    "df['total_screen_time'] = (\n",
    "    df['social_media_hours'] + df['netflix_hours']\n",
    ")\n",
    "\n",
    "df[['social_media_hours', 'netflix_hours', 'total_screen_time']]"
   ]
  },
