   "source": [
    "# Q14. Applying a Function\n",
    "# Create a function that assigns grades using the following rules:\n",
    "\n",
    "# Score 85 or above: A\n",
    "\n",
    "# Score 70 to below 85: B\n",
    "\n",
    "# Score 55 to below 70: C\n",
    "\n",
    "# Score 40 to below 55: D\n",
    "\n",
    "# Score below 40: F\n",
    "\n",
    "# Apply this function to the exam_score column and store the results in a new column named grade.\n",
    "\n",
    "def assign_grade(score):\n",
    "    if score >= 85:\n",
    "        return 'A'\n",
    "    elif score >= 70:\n",
    "        return 'B'\n",
    "    elif score >= 55:\n",
    "        return 'C'\n",
    "    elif score >= 40:\n",
    "        return 'D'\n",
    "    else:\n",
    "        return 'F'\n",
    "\n",
    "\n",
    "df['grade'] = df['exam_score'].apply(assign_grade)\n",
    "\n",
    "df[['exam_score', 'grade']]"
   ]
  },
