    "# Q7. Data Type Conversion\n",
    "# Convert the study_hours_per_day column to numeric values. Handle invalid values appropriately.\n",
    "\n",
    "df['study_hours_per_day'] = pd.to_numeric(\n",
    "    df['study_hours_per_day'],\n",
    "    errors='coerce'\n",
    ")\n",
    "print(df['study_hours_per_day'].dtype)"
   ]
  },
