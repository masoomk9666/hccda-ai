   "source": [
    "# Q9. Multiple Conditions\n",
    "# Display students who study more than 5 hours per day and sleep for at least 7 hours.\n",
    "\n",
    "df[\n",
    "    (df['study_hours_per_day'] > 5) &\n",
    "    (df['sleep_hours'] >= 7)\n",
    "]"
   ]
  },
