     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saad Ali\n"
     ]
    }
   ],
   "source": [
    "# Q1. Student Record\n",
    "# Create a dictionary named student containing the student's name, age, CGPA, and department. Ask the user to enter a key and display its value if the key exists. Otherwise, print \"Key Not Found\".\n",
    "\n",
    "student = {\n",
    "    \"name\" : \"Saad Ali\",\n",
    "    \"age\" : 25,\n",
    "    \"CGPA\" : 3.79,\n",
    "    \"department\": \"Software Engineering\"\n",
    "}\n",
    "\n",
    "key = input(\"Enter a key: \")\n",
    "\n",
    "if key in student:\n",
    "    print(student[key])\n",
    "else:\n",
    "    print(\"Key Not Found\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "48367439",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Ali\n"
     ]
    }
   ],
   "source": [
    "# Q2. Employee Information\n",
    "# Create a dictionary named emp containing the following information:\n",
    "\n",
    "# Name: Ali\n",
    "\n",
    "# Position: HR\n",
    "\n",
    "# Salary: 50000\n",
    "\n",
    "# Department: IT\n",
    "\n",
    "# Ask the user to enter a key and display its corresponding value. If the key does not exist, print \"Invalid Key\".\n",
    "\n",
    "emp = {\n",
    "    \"name\": \"Ali\",\n",
    "    \"position\": \"HR\",\n",
    "    \"salary\": 50000,\n",
    "    \"department\": \"IT\"\n",
    "}\n",
    "\n",
    "key = input(\"Enter a key: \")\n",
    "\n",
    "if key in emp:\n",
    "    print(emp[key])\n",
    "else:\n",
    "    print(\"Invalid Key\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2f524c51",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "03001234567\n"
     ]
    }
   ],
   "source": [
    "# Q3. Contact Book\n",
    "# Create a dictionary containing the names and phone numbers of three contacts: Sara, Ali, and Ahmad. Ask the user to enter a contact name. Display the phone number if the contact exists; otherwise, print \"Contact Not Found\".\n",
    "\n",
    "contacts = {\n",
    "    \"Sara\": \"03001234567\",\n",
    "    \"Ali\": \"03111234567\",\n",
    "    \"Ahmad\": \"03211234567\"\n",
    "}\n",
    "\n",
    "name = input(\"Enter contact name: \")\n",
    "\n",
    "if name in contacts:\n",
    "    print(contacts[name])\n",
    "else:\n",
    "    print(\"Contact Not Found\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fc1dfc6e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'age': 20, 'cgpa': 3.9, 'department': 'SE'}\n"
     ]
    }
   ],
   "source": [
    "# Q4. Nested Student Dictionary\n",
    "# Create a nested dictionary named students containing the following records:\n",
    "\n",
    "# Ali: Age 21, CGPA 3.7, Department CS\n",
    "\n",
    "# Ahmad: Age 22, CGPA 3.4, Department AI\n",
    "\n",
    "# Sara: Age 20, CGPA 3.9, Department SE\n",
    "\n",
    "# Ask the user to enter a student's name and display their complete record. If the student does not exist, print \"Student Not Found\".\n",
    "\n",
    "students = {\n",
    "    \"Ali\": {\n",
    "        \"age\": 21,\n",
    "        \"cgpa\": 3.7,\n",
    "        \"department\": \"CS\"\n",
    "    },\n",
    "    \"Ahmad\": {\n",
    "        \"age\": 22,\n",
    "        \"cgpa\": 3.4,\n",
    "        \"department\": \"AI\"\n",
    "    },\n",
    "    \"Sara\": {\n",
    "        \"age\": 20,\n",
    "        \"cgpa\": 3.9,\n",
    "        \"department\": \"SE\"\n",
    "    }\n",
    "}\n",
    "\n",
    "name = input(\"Enter student name: \")\n",
    "\n",
    "if name in students:\n",
    "    print(students[name])\n",
    "else:\n",
    "    print(\"Student Not Found\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dc799706",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "dict_keys(['name', 'age', 'department'])\n",
      "dict_values(['Ali', 23, 'CS'])\n",
      "dict_items([('name', 'Ali'), ('age', 23), ('department', 'CS')])\n",
      "{'name': 'Ali', 'age': 23, 'department': 'CS', 'cgpa': 3.5}\n"
     ]
    }
   ],
   "source": [
    "# Q5. Dictionary Methods\n",
    "# Consider the following dictionary:\n",
    "# python\n",
    "# student = {\n",
    "#     \"name\": \"Ali\",\n",
    "#     \"age\": 23,\n",
    "#     \"department\": \"CS\"\n",
    "# }\n",
    "# Write code to:\n",
    "\n",
    "# Display all keys.\n",
    "\n",
    "# Display all values.\n",
    "\n",
    "# Display all key-value pairs.\n",
    "\n",
    "# Add a new key \"cgpa\" with the value 3.5 using update().\n",
    "\n",
    "student = {\n",
    "    \"name\": \"Ali\",\n",
    "    \"age\": 23,\n",
    "    \"department\": \"CS\"\n",
    "}\n",
    "\n",
    "# 1. Display all keys\n",
    "print(student.keys())\n",
    "\n",
    "# 2. Display all values\n",
    "print(student.values())\n",
    "\n",
    "# 3. Display all key-value pairs\n",
    "print(student.items())\n",
    "\n",
    "# 4. Add cgpa using update()\n",
    "student.update({\"cgpa\": 3.5})\n",
    "\n",
    "print(student)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "809a8eed",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Product Added to Cart\n"
     ]
    }
   ],
   "source": [
    "# Q6. Online Shopping System\n",
    "# Create a nested dictionary named products containing the following products:\n",
    "\n",
    "# Laptop: Price 120000, Quantity 5\n",
    "\n",
    "# Mouse: Price 1500, Quantity 10\n",
    "\n",
    "# Keyboard: Price 3000, Quantity 0\n",
    "\n",
    "# Ask the user to enter a product name.\n",
    "\n",
    "# If the product exists and its quantity is greater than 0, print \"Product Added to Cart\".\n",
    "\n",
    "# If the quantity is 0, print \"Out of Stock\".\n",
    "\n",
    "# If the product does not exist, print \"Product Not Found\".\n",
    "\n",
    "products = {\n",
    "    \"Laptop\": {\n",
    "        \"price\": 120000,\n",
    "        \"quantity\": 5\n",
    "    },\n",
    "    \"Mouse\": {\n",
    "        \"price\": 1500,\n",
    "        \"quantity\": 10\n",
    "    },\n",
    "    \"Keyboard\": {\n",
    "        \"price\": 3000,\n",
    "        \"quantity\": 0\n",
    "    }\n",
    "}\n",
    "\n",
    "name = input(\"Enter product name: \")\n",
    "\n",
    "if name in products:\n",
    "    if products[name][\"quantity\"] > 0:\n",
    "        print(\"Product Added to Cart\")\n",
    "    else:\n",
    "        print(\"Out of Stock\")\n",
    "else:\n",
    "    print(\"Product Not Found\")"
   ]
  },
